{
  "name": "terminalwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "twatch": "./bin/twatch"
  },
  "scripts": {
    "dev": "bun run src/index.tsx",
    "dev:mock": "TWATCH_MOCK=1 bun run src/index.tsx",
    "start": "bun run src/index.tsx",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "latest",
    "@opentui/react": "latest",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
